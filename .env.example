# MongoDB Atlas connection string
MONGODB_URI=
# Long random string (min 32 chars) used to sign admin session cookies
ADMIN_SESSION_SECRET=
# Public site URL, e.g. https://bianbru.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by `npm run seed` to create the first admin user
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

